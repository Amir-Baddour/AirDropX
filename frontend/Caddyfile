# Serves the built single-page app inside the web container (HTTP only; the edge proxy does HTTPS).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build files never change: cache for a year. index.html must always be fresh.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	# Client-side routes (/app, /claim/:id, ...) all load index.html
	try_files {path} /index.html
	file_server
}
